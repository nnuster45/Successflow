{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "successflow",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "www.successflow.it.com", "custom_domain": true },
    { "pattern": "successflow.it.com", "custom_domain": true }
  ],
  "workers_dev": true
}
